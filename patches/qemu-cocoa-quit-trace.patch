+            NSLog(@"CF_COCOA_QUIT request=terminate");
+        }
+    }
+    BOOL confirmed = [self verifyQuit];
+    if (trace) {
+        NSLog(@"CF_COCOA_QUIT decision=%@", confirmed ? @"quit" : @"cancel");
+    }
+    return confirmed ? NSTerminateNow : NSTerminateCancel;
 }
