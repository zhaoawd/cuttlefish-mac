#!/usr/bin/env python3
"""使用官方 Linux 宿主包的 QEMU，在显式选择 TCG 时替换 CPU 和加速器。"""
import os
from pathlib import Path
import sys

args = sys.argv[1:]
for option, original, replacement in (("-accel", "kvm", "tcg,thread=multi"), ("-cpu", "host", "max")):
    if option in args:
        index = args.index(option) + 1
        if index >= len(args) or args[index].split(",")[0] != original:
            sys.exit(f"不支持的 QEMU 参数 {option}")
        args[index] = replacement + args[index][len(original):]
binary = Path(os.environ["ANDROID_HOST_OUT"]) / "bin/aarch64-linux-gnu/qemu/qemu-system-aarch64"
os.execv(binary, [str(binary), *args])
